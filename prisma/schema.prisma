generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  firstName    String?
  lastName     String?
  createdAt    DateTime @default(now())

  matchPredictions         MatchPrediction[]
  groupStandingPredictions GroupStandingPrediction[]
  bonusPrediction          BonusPrediction?
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Group {
  id   Int    @id @default(autoincrement())
  name String @unique

  teams                    Team[]
  matches                  Match[]
  groupStandingPredictions GroupStandingPrediction[]
}

model Team {
  id        Int    @id @default(autoincrement())
  name      String
  fifaCode  String @unique
  pot       Int
  flagEmoji String
  groupId   Int

  group Group @relation(fields: [groupId], references: [id])

  homeMatches      Match[]                   @relation("HomeTeam")
  awayMatches      Match[]                   @relation("AwayTeam")
  groupPredictions GroupStandingPrediction[]
  bonusChampion    BonusPrediction[]         @relation("Champion")
  bonusRunnerUp    BonusPrediction[]         @relation("RunnerUp")
  bonusDarkHorse   BonusPrediction[]         @relation("DarkHorse")
}

enum Round {
  GROUP_1
  GROUP_2
  GROUP_3
  R32
  R16
  QF
  SF
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Match {
  id              Int         @id @default(autoincrement())
  homeTeamId      Int?
  awayTeamId      Int?
  groupId         Int?
  round           Round
  kickoffTime     DateTime
  homeScore       Int?
  awayScore       Int?
  wentToEt        Boolean?
  wentToPens      Boolean?
  status          MatchStatus @default(SCHEDULED)
  slotDescription String?
  externalId      String?     @unique

  homeTeam Team?  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team?  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  group    Group? @relation(fields: [groupId], references: [id])

  predictions MatchPrediction[]
}

model MatchPrediction {
  id            Int      @id @default(autoincrement())
  userId        Int
  matchId       Int
  homeScore     Int
  awayScore     Int
  predictsEt    Boolean?
  predictsPens  Boolean?
  pointsAwarded Int?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

model GroupStandingPrediction {
  id            Int      @id @default(autoincrement())
  userId        Int
  groupId       Int
  position      Int
  teamId        Int
  pointsAwarded Int?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])

  @@unique([userId, groupId, position])
}

model BonusPrediction {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  championTeamId  Int
  runnerUpTeamId  Int
  topScorerName   String
  darkHorseTeamId Int
  championPts     Int?
  runnerUpPts     Int?
  topScorerPts    Int?
  darkHorsePts    Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  champion  Team @relation("Champion", fields: [championTeamId], references: [id])
  runnerUp  Team @relation("RunnerUp", fields: [runnerUpTeamId], references: [id])
  darkHorse Team @relation("DarkHorse", fields: [darkHorseTeamId], references: [id])
}
