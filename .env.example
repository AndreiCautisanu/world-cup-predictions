# Postgres connection string.
# Local: paste a Railway DATABASE_PUBLIC_URL to point at the live DB,
# or run a local Postgres if you set one up.
# Railway: set as a reference variable on main-node → ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Used by scripts/ that run via `railway run --service Postgres ...`.
# DATABASE_URL inside the Railway runtime is the private network address,
# unreachable from your laptop; DATABASE_PUBLIC_URL works from anywhere.
# Not needed for the Next.js runtime itself.
DATABASE_PUBLIC_URL=

# NextAuth v5 secret. MUST be named AUTH_SECRET (not NEXTAUTH_SECRET) in
# production — the v5 beta does not honour the legacy alias and middleware
# silently passes all requests through if this is missing.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# football-data.org API key — competition WC, free tier.
# Used by lib/football-api.ts for both the bootstrap script and the
# scheduled sync at POST /api/admin/sync-results.
FOOTBALL_DATA_API_KEY=

# Bearer secret the cron must present to POST /api/admin/sync-results.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Overrides the seed script's default invite code (cupa2026).
SEED_INVITE_CODE=cupa2026
